{
  "name": "originalvoices",
  "version": "1.0.0",
  "description": "TypeScript client for the OriginalVoices API: ask Digital Twins of real people",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "keywords": [
    "originalvoices",
    "digital-twins",
    "audience-research",
    "api",
    "sdk"
  ],
  "author": "OriginalVoices <support@originalvoices.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovlabs/originalvoices-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.originalvoices.ai/api/reference/",
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "engines": {
    "node": ">=20"
  }
}
