{
  "name": "@originalvoices/cli",
  "version": "2.0.0",
  "description": "CLI for the OriginalVoices API",
  "type": "module",
  "bin": {
    "ov": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
